# Copy to .env and fill in your own values.
#
# Only Stage 3 (the LLM router) reads any of this. Stage 1 extraction,
# skeleton compression, candidate generation, resolution and closure all
# run offline, as do every metric suite under evaluation/.

# ---- LLM (any OpenAI-protocol endpoint: DeepSeek, OpenAI, ...) ----
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# Gateway input ceiling. The router shards oversized skeletons and keeps
# a margin for tokenizer differences between providers.
LLM_MAX_INPUT_TOKENS=8192
LLM_INPUT_TOKEN_SAFETY_MARGIN=512

# ---- Stage 2: skeleton compression ----
SKELETON_HEAD_CHARS=40
SKELETON_TAIL_CHARS=30
SKELETON_ENABLE_RLE=true
SKELETON_RLE_THRESHOLD=3
SKELETON_MAX_RLE_GROUP=10
SKELETON_ENABLE_CANDIDATE_SPARSE=true
SKELETON_CANDIDATE_CONTEXT_BLOCKS=1
SKELETON_SPARSE_PREAMBLE_BLOCKS=8

# ---- Map-Reduce sliding window for very long documents ----
SLIDING_WINDOW_THRESHOLD=500
WINDOW_SIZE=300
WINDOW_OVERLAP=50

# ---- Stage 4: fuzzy anchoring ----
FUZZY_ANCHOR_RADIUS=5
FUZZY_MIN_SIMILARITY=0.4

# ---- Strict-first routing / escape-risk gates ----
STRICT_FIRST_ROUTING=true
ESCAPE_VOTE_MAX_TEXT_LEN=140
ESCAPE_VOTE_MAX_WORDS=12
ESCAPE_VOTE_TITLE_SIMILARITY=0.5

LOG_LEVEL=INFO
